[Unit]
Description=Antigravity CLI Web Bridge Daemon
After=network.target agy-brain.service

[Service]
Type=simple
WorkingDirectory=%h/.gemini/antigravity-cli/bridge
ExecStart=/usr/bin/python3 %h/.gemini/antigravity-cli/bridge/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
